/**
 * update-videos-json.js - Database Schema Validation and Verification Script
 */
const fs = require('fs');
const path = require('path');

const filePath = path.join(__dirname, '../videos.json');
let dbData = { models: [], streams: [], homepage_thumbnails: [] };

if (fs.existsSync(filePath)) {
    try {
        const fileContent = fs.readFileSync(filePath, 'utf8');
        const parsed = JSON.parse(fileContent);
        
        // Ensure the parsed data is a valid non-null object (not an array or primitive)
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
            dbData = parsed;
        } else {
            console.warn('⚠️ Warning: Existing videos.json root is not an object. Resetting structure.');
        }
    } catch (e) {
        console.error('⚠️ Could not parse existing videos.json (invalid JSON), starting fresh.');
    }
}

// Guarantee all required schema arrays exist and are valid arrays
dbData.models = Array.isArray(dbData.models) ? dbData.models : [];
dbData.streams = Array.isArray(dbData.streams) ? dbData.streams : [];
dbData.homepage_thumbnails = Array.isArray(dbData.homepage_thumbnails) ? dbData.homepage_thumbnails : [];

try {
    fs.writeFileSync(filePath, JSON.stringify(dbData, null, 4), 'utf8');
    console.log('✅ Successfully updated and verified videos.json schema!');
} catch (e) {
    console.error('❌ Error writing to videos.json:', e.message);
    process.exit(1);
}
